# Copy this file to .env and add ONE key. Without a key the app still works (template explanations).
# Groq (free): https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Or Google Gemini (free tier): https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Optional: override the model name if the default is retired
# LLM_MODEL=
